# ---------------------------------------------------------------------------
# MXPCB landing — environment variables
#
# Copy this file to .env.local and fill in real values. .env.local is
# gitignored and must never be committed.
#
#   cp .env.example .env.local
#
# In production these are set in the Vercel project settings, not in a file.
#
# NEXT_PUBLIC_ prefix: Next.js inlines these into the JavaScript bundle sent
# to the browser, so anyone can read them in devtools. Never put a secret
# behind that prefix. They are also frozen at build time -- changing one in
# Vercel requires a rebuild, not just a redeploy.
# (node_modules/next/dist/docs/01-app/02-guides/environment-variables.md)
# ---------------------------------------------------------------------------


# --- Site ------------------------------------------------------------------

# Canonical origin, no trailing slash. Used for metadataBase, canonical URLs,
# Open Graph, sitemap.xml and robots.txt.
# Required: a relative URL field without metadataBase is a BUILD ERROR, not a
# warning. Use http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=https://mexicopcb.com


# --- Resend (contact form email) -------------------------------------------

# Server-side only. Never expose, never commit, never paste into an issue or
# a chat. If it leaks, rotate it in the Resend dashboard immediately --
# removing it from a later commit does not remove it from git history.
# Get it at: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. MUST be on a domain verified in Resend (SPF + DKIM records
# on the sending domain). An unverified domain is rejected at send time, so
# the form fails in production while working nowhere -- verify DNS first.
# This is a no-reply sender; the visitor's own address is set as reply-to so
# hitting reply reaches them directly.
CONTACT_FROM_EMAIL=web@mexicopcb.com

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=contacto@mexicopcb.com


# --- Cloudflare Turnstile (spam protection) --------------------------------

# Public widget key. Safe to expose -- it is rendered in the page by design.
# Get both keys at: https://dash.cloudflare.com -> Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x0000000000000000000000

# Server-side only. Used to verify the token the widget returns.
# Verification happens inside the Server Action, because a Server Action is
# reachable by direct POST outside the UI -- a token checked only in the
# browser protects nothing.
# (node_modules/next/dist/docs/01-app/01-getting-started/07-mutating-data.md)
TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000000000000

# Cloudflare publishes dummy always-pass and always-fail keys for local
# development; see their Turnstile docs for the current values.


# --- Google Tag Manager (optional) -----------------------------------------

# Container ID, format GTM-XXXXXXX. Leave empty to disable analytics entirely
# -- the site renders and the form works without it. Set it only when the
# aviso de privacidad discloses the cookies GTM sets.
NEXT_PUBLIC_GTM_ID=
